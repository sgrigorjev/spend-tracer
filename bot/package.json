{
  "name": "spend-tracer",
  "version": "1.0.0",
  "description": "Telegram bot that analyzes expenses from a chat (text, receipt photos, voice) into a local SQLite database via OpenAI",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test \"test/*.test.ts\"",
    "import": "node src/cli/import.ts",
    "backfill:rates": "node src/cli/backfill-rates.ts",
    "generate:voices": "node test/scripts/generate-voices.ts",
    "generate:receipts": "node test/scripts/generate-receipts.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "expenses",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.1",
    "openai": "^7.20.0",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
