TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Optional: path to the SQLite database file (created on first run)
# DB_PATH=data/spend-tracer.db
# Optional: override the default models
# OPENAI_MODEL_TEXT=gpt-4o-mini
# OPENAI_MODEL_VISION=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_LANGUAGE=ru
# Optional: logging. Level: trace|debug|info|warn|error|fatal (default info).
# LOG_LEVEL=debug
# LOG_FILE=/var/log/spend-tracer.log  # unset = logs go to stdout
# LOG_PRETTY=true                     # human-readable output for local dev

# Web UI (api service). Fill these to enable sign-in.
# GOOGLE_CLIENT_ID and GOOGLE_ALLOWED_EMAILS are required by the api service.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=
SESSION_SECRET=
# Optional: API_PORT=3000
# Optional: API_DB_PATH=data/api.db
