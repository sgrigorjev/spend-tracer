TELEGRAM_BOT_TOKEN=
# Bot username, used to build the Telegram link deep link (without the @).
# TELEGRAM_BOT_USERNAME=my_spend_tracer_bot
# Public web UI URL, shown to senders who have not linked a Telegram account.
# WEB_URL=http://127.0.0.1:8001
OPENAI_API_KEY=
# Optional: path to the shared SQLite database file, used by the bot and the API
# (created on first run)
# DB_PATH=data/spend-tracer.db
# Optional: override the default models
# OPENAI_MODEL_TEXT=gpt-4o-mini
# OPENAI_MODEL_VISION=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_LANGUAGE=ru
# Optional: logging. Level: trace|debug|info|warn|error|fatal (default info).
# LOG_LEVEL=debug
# LOG_FILE=/var/log/spend-tracer.log  # unset = logs go to stdout
# LOG_PRETTY=true                     # human-readable output for local dev

# Web UI (api service). Fill these to enable sign-in.
# GOOGLE_CLIENT_ID and GOOGLE_ALLOWED_EMAILS are required by the api service.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=
SESSION_SECRET=
# Optional: session cookie lifetime in seconds. Unset or 0 keeps a session
# cookie that ends when the browser closes. A positive value makes the cookie
# persistent across browser restarts.
# SESSION_MAX_AGE=2592000
# Optional: API_PORT=3000
