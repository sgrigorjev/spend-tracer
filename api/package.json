{
  "name": "spend-tracer-api",
  "version": "1.0.0",
  "description": "Fastify API for the spend-tracer web UI: Google sign-in and a protected dashboard",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test \"test/*.test.ts\"",
